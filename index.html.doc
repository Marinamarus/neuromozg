<body><div style="font-family:Calibri,sans-serif;font-size:11pt;"><p>&nbsp;</p><p><strong>&lt;!DOCTYPE html&gt;<br>&lt;html lang="ru"&gt;<br>&lt;head&gt;<br>&nbsp; &lt;meta charset="UTF-8" /&gt;<br>&nbsp; &lt;meta name="viewport" content="width=device-width, initial-scale=1.0" /&gt;<br>&nbsp; &lt;meta name="description" content="NEUROMOZG — онлайн-школа, личный хаб, курсы, лендинги и магазины." /&gt;<br>&nbsp; &lt;title&gt;NEUROMOZG | Онлайн школа&lt;/title&gt;<br>&nbsp; &lt;link rel="preconnect" href="https://fonts.googleapis.com"&gt;<br>&nbsp; &lt;link rel="preconnect" href="https://fonts.gstatic.com" crossorigin&gt;<br>&nbsp; &lt;link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet"&gt;<br>&nbsp; &lt;link rel="stylesheet" href="style.css" /&gt;<br>&lt;/head&gt;<br>&lt;body&gt;<br>&nbsp; &lt;div class="bg-blur bg1"&gt;&lt;/div&gt;<br>&nbsp; &lt;div class="bg-blur bg2"&gt;&lt;/div&gt;</strong></p><p><strong>&nbsp; &lt;header class="header"&gt;<br>&nbsp; &nbsp; &lt;div class="container nav"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a class="logo" href="#home"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;span class="logo-mark"&gt;N&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;NEUROMOZG&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/a&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &lt;nav class="menu"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#about"&gt;О школе&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#programs"&gt;Программы&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#links"&gt;Ссылки&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#contacts"&gt;Контакты&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/nav&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &lt;button class="burger" id="burger" aria-label="Меню"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;&lt;/span&gt;&lt;span&gt;&lt;/span&gt;&lt;span&gt;&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/button&gt;<br>&nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &lt;div class="mobile-menu" id="mobileMenu"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a href="#about"&gt;О школе&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a href="#programs"&gt;Программы&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a href="#links"&gt;Ссылки&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a href="#contacts"&gt;Контакты&lt;/a&gt;<br>&nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &lt;/header&gt;</strong></p><p><strong>&nbsp; &lt;main id="home"&gt;<br>&nbsp; &nbsp; &lt;section class="hero"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;div class="container hero-grid"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="hero-content"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="eyebrow"&gt;ОНЛАЙН ШКОЛА НЕЙРОМОЗГ&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h1&gt;Личный хаб для обучения, лендингов и магазинов&lt;/h1&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="hero-text"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Здесь собраны все направления проекта: обучение, продукты, сервисы, полезные ссылки и быстрый доступ ко всем площадкам.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/p&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="hero-actions"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#links" class="btn btn-primary"&gt;Открыть ссылки&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="#programs" class="btn btn-secondary"&gt;Смотреть программы&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="stats"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="stat"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;strong&gt;10+&lt;/strong&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;направлений&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="stat"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;strong&gt;24/7&lt;/strong&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;доступ к материалам&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="stat"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;strong&gt;1&lt;/strong&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;удобный хаб&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="hero-card"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;img src="images/hero.jpg" alt="NEUROMOZG" class="hero-image" /&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="hero-card-body"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;NEUROMOZG&lt;/h2&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Школа, где удобно хранить, показывать и продавать свои проекты.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &lt;/section&gt;</strong></p><p><strong>&nbsp; &nbsp; &lt;section class="section" id="about"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;div class="container"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="section-head"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="eyebrow"&gt;О проекте&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;Единая точка входа для вашей аудитории&lt;/h2&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="cards three"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Обучение&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Курсы, уроки, марафоны и программы для учеников в одном месте.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Продажи&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Лендинги, воронки, товары и магазины с быстрым переходом.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Коммуникация&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Контакты, Telegram, WhatsApp, форма заявки и обратная связь.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &lt;/section&gt;</strong></p><p><strong>&nbsp; &nbsp; &lt;section class="section alt" id="programs"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;div class="container"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="section-head"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="eyebrow"&gt;Программы&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;Что можно разместить на хабе&lt;/h2&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="cards four"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card feature"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="icon"&gt;1&lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Курсы&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Полный каталог обучающих программ.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card feature"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="icon"&gt;2&lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Лендинги&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Отдельные посадочные страницы под продукты.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card feature"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="icon"&gt;3&lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Магазины&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Ссылки на товары, услуги и оплату.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;article class="card feature"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="icon"&gt;4&lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h3&gt;Соцсети&lt;/h3&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p&gt;Telegram, Instagram, YouTube и другие каналы.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/article&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &lt;/section&gt;</strong></p><p><strong>&nbsp; &nbsp; &lt;section class="section" id="links"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;div class="container"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="section-head"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="eyebrow"&gt;Быстрые ссылки&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;Куда переходить с главной страницы&lt;/h2&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="links-grid"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a class="link-card" href="https://t.me/" target="_blank" rel="noopener"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;Telegram&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;small&gt;Канал / чат / бот&lt;/small&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a class="link-card" href="#" target="_blank" rel="noopener"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;Лендинг 1&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;small&gt;Основной продукт&lt;/small&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a class="link-card" href="#" target="_blank" rel="noopener"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;Магазин&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;small&gt;Товары и оплата&lt;/small&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a class="link-card" href="#" target="_blank" rel="noopener"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;span&gt;Курс&lt;/span&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;small&gt;Обучающая программа&lt;/small&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &lt;/section&gt;</strong></p><p><strong>&nbsp; &nbsp; &lt;section class="section alt" id="contacts"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;div class="container contact-grid"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="eyebrow"&gt;Контакты&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;h2&gt;Связь с проектом&lt;/h2&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;p class="contact-text"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Добавьте сюда ваши актуальные ссылки, почту и мессенджеры.<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/p&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;div class="contact-list"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="mailto:hello@example.com"&gt;hello@example.com&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="https://t.me/" target="_blank" rel="noopener"&gt;@neuromozg&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;a href="https://wa.me/" target="_blank" rel="noopener"&gt;WhatsApp&lt;/a&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/div&gt;</strong></p><p><strong>&nbsp; &nbsp; &nbsp; &nbsp; &lt;form class="form" name="contact" method="POST" data-netlify="true"&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="hidden" name="form-name" value="contact" /&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Ваше имя<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="text" name="name" placeholder="Введите имя" /&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Телефон или Telegram<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;input type="text" name="contact" placeholder="@username или телефон" /&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; Сообщение<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;textarea name="message" rows="5" placeholder="Напишите, что вам нужно"&gt;&lt;/textarea&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;/label&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &nbsp; &lt;button type="submit" class="btn btn-primary"&gt;Отправить заявку&lt;/button&gt;<br>&nbsp; &nbsp; &nbsp; &nbsp; &lt;/form&gt;<br>&nbsp; &nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &nbsp; &lt;/section&gt;<br>&nbsp; &lt;/main&gt;</strong></p><p><strong>&nbsp; &lt;footer class="footer"&gt;<br>&nbsp; &nbsp; &lt;div class="container footer-inner"&gt;<br>&nbsp; &nbsp; &nbsp; &lt;p&gt;© 2026 NEUROMOZG. Все права защищены.&lt;/p&gt;<br>&nbsp; &nbsp; &nbsp; &lt;a href="#home"&gt;Наверх&lt;/a&gt;<br>&nbsp; &nbsp; &lt;/div&gt;<br>&nbsp; &lt;/footer&gt;</strong></p><p><strong>&nbsp; &lt;script src="script.js"&gt;&lt;/script&gt;<br>&lt;/body&gt;<br>&lt;/html&gt;</strong></p></div></body></html>
