--NEXT.ITEM-BOUNDARY
Content-Type: text/html; charset="utf-8"
Content-Location: https://online-bloknot.ru/

<!DOCTYPE html>
<html xmlns:o="urn:schemas-microsoft-com:office:office" 
xmlns:w="urn:schemas-microsoft-com:office:word" 
xmlns="http://www.w3.org/TR/REC-html40">
<head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<!--[if gte mso 9]><xml>
 <w:WordDocument>
  <w:View>Print</w:View>
  <w:GrammarState>Clean</w:GrammarState>
  <w:ValidateAgainstSchemas/>
  <w:SaveIfXMLInvalid>false</w:SaveIfXMLInvalid>
  <w:IgnoreMixedContent>false</w:IgnoreMixedContent>
  <w:AlwaysShowPlaceholderText>false</w:AlwaysShowPlaceholderText>
  <w:BrowserLevel>MicrosoftInternetExplorer4</w:BrowserLevel>
 </w:WordDocument>
</xml><![endif]--><!--[if gte mso 9]><xml>
 <w:LatentStyles DefLockedState="false" LatentStyleCount="156">
 </w:LatentStyles>
</xml><![endif]-->
<style>

</style>
</head>
<body><div style="font-family:Calibri,sans-serif;font-size:11pt;"><p>&nbsp;</p><p>&nbsp;</p><p><strong>:root{<br>&nbsp; --bg:#07111f;<br>&nbsp; --bg2:#0c1b31;<br>&nbsp; --card:rgba(255,255,255,.08);<br>&nbsp; --stroke:rgba(255,255,255,.12);<br>&nbsp; --text:#eef3ff;<br>&nbsp; --muted:#b8c4e0;<br>&nbsp; --accent:#6c7bff;<br>&nbsp; --accent2:#33d1ff;<br>&nbsp; --shadow:0 20px 60px rgba(0,0,0,.35);<br>&nbsp; --radius:24px;<br>}</strong></p><p><strong>*{box-sizing:border-box}<br>html{scroll-behavior:smooth}<br>body{<br>&nbsp; margin:0;<br>&nbsp; font-family:'Inter',sans-serif;<br>&nbsp; background:<br>&nbsp; &nbsp; radial-gradient(circle at top left, #12365f 0, transparent 35%),<br>&nbsp; &nbsp; linear-gradient(180deg, var(--bg), var(--bg2));<br>&nbsp; color:var(--text);<br>&nbsp; min-height:100vh;<br>}</strong></p><p><strong>a{color:inherit;text-decoration:none}<br>img{max-width:100%;display:block}</strong></p><p><strong>.container{<br>&nbsp; width:min(1180px, calc(100% - 32px));<br>&nbsp; margin:0 auto;<br>}</strong></p><p><strong>.bg-blur{<br>&nbsp; position:fixed;<br>&nbsp; z-index:-1;<br>&nbsp; filter:blur(90px);<br>&nbsp; opacity:.35;<br>&nbsp; pointer-events:none;<br>}<br>.bg1{width:260px;height:260px;background:#4f6cff;top:10%;left:-60px}<br>.bg2{width:300px;height:300px;background:#20d7ff;bottom:5%;right:-90px}</strong></p><p><strong>.header{<br>&nbsp; position:sticky;<br>&nbsp; top:0;<br>&nbsp; z-index:20;<br>&nbsp; backdrop-filter:blur(18px);<br>&nbsp; background:rgba(7,17,31,.55);<br>&nbsp; border-bottom:1px solid var(--stroke);<br>}</strong></p><p><strong>.nav{<br>&nbsp; height:76px;<br>&nbsp; display:flex;<br>&nbsp; align-items:center;<br>&nbsp; justify-content:space-between;<br>&nbsp; gap:16px;<br>}</strong></p><p><strong>.logo{<br>&nbsp; display:flex;<br>&nbsp; align-items:center;<br>&nbsp; gap:12px;<br>&nbsp; font-weight:800;<br>&nbsp; letter-spacing:.08em;<br>}<br>.logo-mark{<br>&nbsp; width:40px;height:40px;border-radius:14px;<br>&nbsp; display:grid;place-items:center;<br>&nbsp; background:linear-gradient(135deg,var(--accent),var(--accent2));<br>&nbsp; color:#fff;<br>&nbsp; box-shadow:var(--shadow);<br>}</strong></p><p><strong>.menu{<br>&nbsp; display:flex;<br>&nbsp; gap:24px;<br>&nbsp; color:var(--muted);<br>}<br>.menu a:hover{color:#fff}</strong></p><p><strong>.burger{<br>&nbsp; display:none;<br>&nbsp; background:none;border:0;padding:0;<br>&nbsp; width:40px;height:40px;<br>}<br>.burger span{<br>&nbsp; display:block;<br>&nbsp; height:2px;width:24px;<br>&nbsp; background:#fff;<br>&nbsp; margin:5px auto;<br>&nbsp; border-radius:2px;<br>}</strong></p><p><strong>.mobile-menu{<br>&nbsp; display:none;<br>&nbsp; padding:14px 16px 18px;<br>&nbsp; border-top:1px solid var(--stroke);<br>&nbsp; background:rgba(7,17,31,.92);<br>}<br>.mobile-menu a{<br>&nbsp; display:block;<br>&nbsp; padding:12px 0;<br>&nbsp; color:var(--muted);<br>}</strong></p><p><strong>.hero{padding:64px 0 36px}<br>.hero-grid{<br>&nbsp; display:grid;<br>&nbsp; grid-template-columns:1.25fr .95fr;<br>&nbsp; gap:28px;<br>&nbsp; align-items:center;<br>}<br>.eyebrow{<br>&nbsp; margin:0 0 14px;<br>&nbsp; color:var(--accent2);<br>&nbsp; text-transform:uppercase;<br>&nbsp; letter-spacing:.16em;<br>&nbsp; font-size:.78rem;<br>&nbsp; font-weight:700;<br>}<br>.hero h1{<br>&nbsp; margin:0;<br>&nbsp; font-size:clamp(2.4rem, 5vw, 4.8rem);<br>&nbsp; line-height:1.02;<br>&nbsp; letter-spacing:-.05em;<br>}<br>.hero-text{<br>&nbsp; max-width:620px;<br>&nbsp; color:var(--muted);<br>&nbsp; font-size:1.05rem;<br>&nbsp; line-height:1.7;<br>&nbsp; margin:20px 0 0;<br>}</strong></p><p><strong>.hero-actions{<br>&nbsp; display:flex;<br>&nbsp; flex-wrap:wrap;<br>&nbsp; gap:14px;<br>&nbsp; margin-top:28px;<br>}</strong></p><p><strong>.btn{<br>&nbsp; display:inline-flex;<br>&nbsp; align-items:center;<br>&nbsp; justify-content:center;<br>&nbsp; padding:14px 22px;<br>&nbsp; border-radius:16px;<br>&nbsp; font-weight:700;<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; transition:.2s ease;<br>}<br>.btn:hover{transform:translateY(-2px)}<br>.btn-primary{<br>&nbsp; background:linear-gradient(135deg,var(--accent),var(--accent2));<br>&nbsp; color:#081120;<br>&nbsp; border:none;<br>}<br>.btn-secondary{<br>&nbsp; background:rgba(255,255,255,.06);<br>&nbsp; color:#fff;<br>}</strong></p><p><strong>.stats{<br>&nbsp; display:grid;<br>&nbsp; grid-template-columns:repeat(3,1fr);<br>&nbsp; gap:14px;<br>&nbsp; margin-top:30px;<br>}<br>.stat{<br>&nbsp; background:var(--card);<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; border-radius:20px;<br>&nbsp; padding:18px;<br>&nbsp; box-shadow:var(--shadow);<br>}<br>.stat strong{<br>&nbsp; display:block;<br>&nbsp; font-size:1.6rem;<br>&nbsp; margin-bottom:6px;<br>}<br>.stat span{color:var(--muted);font-size:.95rem}</strong></p><p><strong>.hero-card{<br>&nbsp; background:rgba(255,255,255,.06);<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; border-radius:30px;<br>&nbsp; overflow:hidden;<br>&nbsp; box-shadow:var(--shadow);<br>}<br>.hero-image{<br>&nbsp; width:100%;<br>&nbsp; aspect-ratio:4/4.5;<br>&nbsp; object-fit:cover;<br>&nbsp; background:#12213a;<br>}<br>.hero-card-body{<br>&nbsp; padding:22px;<br>}<br>.hero-card-body h2{margin:0 0 8px}<br>.hero-card-body p{margin:0;color:var(--muted);line-height:1.6}</strong></p><p><strong>.section{padding:28px 0 64px}<br>.alt{<br>&nbsp; background:linear-gradient(180deg, rgba(255,255,255,.03), rgba(255,255,255,0));<br>&nbsp; border-top:1px solid rgba(255,255,255,.05);<br>&nbsp; border-bottom:1px solid rgba(255,255,255,.05);<br>}</strong></p><p><strong>.section-head h2{<br>&nbsp; margin:0;<br>&nbsp; font-size:clamp(1.7rem, 3vw, 2.8rem);<br>&nbsp; line-height:1.1;<br>}</strong></p><p><strong>.cards{<br>&nbsp; margin-top:28px;<br>&nbsp; display:grid;<br>&nbsp; gap:18px;<br>}<br>.cards.three{grid-template-columns:repeat(3,1fr)}<br>.cards.four{grid-template-columns:repeat(4,1fr)}</strong></p><p><strong>.card{<br>&nbsp; background:var(--card);<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; border-radius:24px;<br>&nbsp; padding:22px;<br>&nbsp; box-shadow:var(--shadow);<br>}<br>.card h3{margin:0 0 10px;font-size:1.15rem}<br>.card p{margin:0;color:var(--muted);line-height:1.65}</strong></p><p><strong>.feature .icon{<br>&nbsp; width:42px;height:42px;border-radius:14px;<br>&nbsp; display:grid;place-items:center;<br>&nbsp; background:linear-gradient(135deg,var(--accent),var(--accent2));<br>&nbsp; color:#06101d;<br>&nbsp; font-weight:800;<br>&nbsp; margin-bottom:16px;<br>}</strong></p><p><strong>.links-grid{<br>&nbsp; margin-top:28px;<br>&nbsp; display:grid;<br>&nbsp; grid-template-columns:repeat(4,1fr);<br>&nbsp; gap:16px;<br>}<br>.link-card{<br>&nbsp; padding:20px;<br>&nbsp; border-radius:22px;<br>&nbsp; background:rgba(255,255,255,.06);<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; transition:.2s ease;<br>}<br>.link-card:hover{transform:translateY(-2px);background:rgba(255,255,255,.1)}<br>.link-card span{<br>&nbsp; display:block;<br>&nbsp; font-weight:700;<br>&nbsp; font-size:1.05rem;<br>&nbsp; margin-bottom:6px;<br>}<br>.link-card small{color:var(--muted)}</strong></p><p><strong>.contact-grid{<br>&nbsp; display:grid;<br>&nbsp; grid-template-columns:1fr 1fr;<br>&nbsp; gap:28px;<br>&nbsp; align-items:start;<br>}<br>.contact-text{color:var(--muted);line-height:1.7}<br>.contact-list{<br>&nbsp; display:grid;<br>&nbsp; gap:12px;<br>&nbsp; margin-top:18px;<br>}<br>.contact-list a{<br>&nbsp; display:inline-flex;<br>&nbsp; width:max-content;<br>&nbsp; padding:12px 16px;<br>&nbsp; border-radius:14px;<br>&nbsp; background:rgba(255,255,255,.06);<br>&nbsp; border:1px solid var(--stroke);<br>}</strong></p><p><strong>.form{<br>&nbsp; background:var(--card);<br>&nbsp; border:1px solid var(--stroke);<br>&nbsp; border-radius:28px;<br>&nbsp; padding:22px;<br>&nbsp; box-shadow:var(--shadow);<br>}<br>.form label{<br>&nbsp; display:block;<br>&nbsp; margin-bottom:16px;<br>&nbsp; color:#fff;<br>&nbsp; font-weight:600;<br>}<br>.form input,<br>.form textarea{<br>&nbsp; width:100%;<br>&nbsp; margin-top:8px;<br>&nbsp; padding:14px 16px;<br>&nbsp; border-radius:14px;<br>&nbsp; border:1px solid rgba(255,255,255,.12);<br>&nbsp; background:rgba(4,10,18,.45);<br>&nbsp; color:#fff;<br>&nbsp; outline:none;<br>&nbsp; font:inherit;<br>}<br>.form input:focus,<br>.form textarea:focus{<br>&nbsp; border-color:rgba(51,209,255,.65);<br>&nbsp; box-shadow:0 0 0 4px rgba(51,209,255,.12);<br>}</strong></p><p><strong>.footer{<br>&nbsp; padding:22px 0 30px;<br>&nbsp; color:var(--muted);<br>}<br>.footer-inner{<br>&nbsp; display:flex;<br>&nbsp; justify-content:space-between;<br>&nbsp; gap:12px;<br>&nbsp; align-items:center;<br>&nbsp; border-top:1px solid var(--stroke);<br>&nbsp; padding-top:18px;<br>}</strong></p><p><strong>@media (max-width: 980px){<br>&nbsp; .hero-grid,<br>&nbsp; .contact-grid,<br>&nbsp; .cards.three,<br>&nbsp; .cards.four,<br>&nbsp; .links-grid{<br>&nbsp; &nbsp; grid-template-columns:1fr 1fr;<br>&nbsp; }<br>&nbsp; .hero{padding-top:40px}<br>}</strong></p><p><strong>@media (max-width: 720px){<br>&nbsp; .menu{display:none}<br>&nbsp; .burger{display:block}<br>&nbsp; .mobile-menu.open{display:block}<br>&nbsp; .hero-grid,<br>&nbsp; .contact-grid,<br>&nbsp; .cards.three,<br>&nbsp; .cards.four,<br>&nbsp; .links-grid,<br>&nbsp; .stats{<br>&nbsp; &nbsp; grid-template-columns:1fr;<br>&nbsp; }<br>&nbsp; .hero-actions{flex-direction:column}<br>&nbsp; .btn{width:100%}<br>&nbsp; .footer-inner{flex-direction:column;align-items:flex-start}<br>}</strong></p></div></body></html>
--NEXT.ITEM-BOUNDARY--